# Configuración general del Monorepo ytms-player
PORT=8080
MAX_WORKERS=3

# Mapeo de rutas entre el Host (Tauri) y el Contenedor Docker (Go)
# Permite que cualquier sub-workspace o directorio elegido dentro del directorio base sea resuelto por el contenedor
YTMS_PLAYER_WORKSPACE_HOST=./workspace
HOST_WORKSPACE_PREFIX=/home/joelsanchz/Projects/yt-player/workspace
CONTAINER_WORKSPACE_PREFIX=/app/workspace

# Autenticación y Cookies (SDD Sección 8)
COOKIES_FILE=/app/config/cookies.txt
OAUTH_MOCK_MODE=true
YOUTUBE_API_KEY=
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
