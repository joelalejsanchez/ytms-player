# Configuración general del Monorepo ytms-player
PORT=8080
MAX_WORKERS=3

# Mapeo dinámico multiplataforma entre Host (Linux / Windows) y Contenedor Docker (Go)
# Por defecto en docker-compose.yml se usa automáticamente:
#   - En Linux/macOS: ${HOME}/Music/ytms-player
#   - En Windows:     ${USERPROFILE}/Music/ytms-player (equivalente a %USERPROFILE%\Music\ytms-player)
# Si deseas sobrescribirlo manualmente, descomenta la siguiente línea:
# YTMS_PLAYER_WORKSPACE_HOST=./workspace
CONTAINER_WORKSPACE_PREFIX=/app/workspace

# Autenticación OAuth 2.0 y Cookies (SDD Sección 8)
COOKIES_FILE=/app/config/cookies.txt
OAUTH_MOCK_MODE=false
OAUTH_CLIENT_ID=
OAUTH_CLIENT_SECRET=
OAUTH_REDIRECT_URI=http://127.0.0.1:8080/api/oauth/callback
OAUTH_TOKEN_FILE=/app/config/oauth_token.json
